# Dependencies and build output
node_modules/
dist/
.wrangler/
*.tsbuildinfo

# Local environment and secrets (Vite reads .env files; Wrangler reads .dev.vars)
.env
.env.*
.dev.vars*

# Logs and test reports
*.log
npm-debug.log*
coverage/
test-results/
playwright-report/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local folders of the tools used to build the project
.claude/settings.local.json
.claude/worktrees/
generated-images/
# Working captures and tool logs; the curated captures live in docs/images/
.impeccable/review/
.impeccable/questions/

# Third-party reference material (local reference only, never on the page or in git)
.reference/

# 4D packs that no page uses: they are regenerated byte for byte with /bake (recipes deer-meadow and cat-alley)
sites/4d-os/public/packs/deer-synthetic/
sites/4d-os/public/packs/cat-alley/
