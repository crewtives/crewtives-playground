{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // playground.crewtives.com: an assets-only Worker that serves dist/, with the museum at the root,
  // 4D.OS under 4d-os/ and the other works in their own folders.
  "name": "crewtives-playground",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "../dist",
    // An unknown path gets dist/404.html with a 404 status, at any depth (the 4D.OS build has no
    // 404.html of its own, so /4d-os/… falls through to the root one). _redirects still come first.
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "playground.crewtives.com", "custom_domain": true }],
  // Also keep the Worker reachable on its default Cloudflare subdomain.
  "workers_dev": true
}
